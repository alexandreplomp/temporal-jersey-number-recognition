# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# Local temporary files
/tmp/
/temp/
*.tmp
*.swp
*~

# Raw data is shared separately and never committed
/data

# Outputs of the blocks: remade by reproduce.sh. Final weights live in weights/; the table and graphs
# of the reported run stay in results/compare/. Each run's config, history, metrics and predictions are
# kept, so every number in the table can be traced; its weights and pictures are not.
/results/runs/**/*.pt
/results/runs/**/*.png
/results/boxes/

# macOS
.DS_Store
